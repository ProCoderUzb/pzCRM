# Security Settings
DJANGO_SECRET_KEY=replace-this-with-a-very-long-and-secure-random-key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=crm.educationpro.uz,127.0.0.1,localhost

# CORS Settings (Frontend domains that can access API)
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://crm.educationpro.uz,http://localhost:5173

# Database (Optional: If you switch to PostgreSQL)
# DB_NAME=prozone
# DB_USER=myuser
# DB_PASSWORD=mypassword
# DB_HOST=127.0.0.1
# DB_PORT=5432
