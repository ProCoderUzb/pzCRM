# Security Settings
DJANGO_SECRET_KEY=replace-this-with-a-very-long-and-secure-random-key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,127.0.0.1,localhost

# CORS Settings (Frontend domains that can access API)
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Database (Optional: If you switch to PostgreSQL)
# DB_NAME=prozone
# DB_USER=myuser
# DB_PASSWORD=mypassword
# DB_HOST=127.0.0.1
# DB_PORT=5432
